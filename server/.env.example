# ==============================================================================
# Devfolio Admin API - Environment Variables Example
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
# SQLite for local testing:
DATABASE_URL=sqlite:///./devfolio.db
# PostgreSQL for production (uncomment and replace with your database credentials):
# DATABASE_URL=postgresql://username:password@localhost:5432/devfolio_db

# Authentication & Security
# Generate a strong secret key in production (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# Default Initial Admin Credentials (used by `python app/seed.py` / `npm run seed`)
ADMIN_EMAIL=admin@devfolio.com
ADMIN_PASSWORD=admin12345

# Server Networking
HOST=0.0.0.0
PORT=8000

# Optional: Google Gemini API Key
# Enhances Magic automated project import copywriting and synthesis.
# If omitted, a built-in deterministic synthesizer runs automatically.
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token
# Increases GitHub API rate limit for Magic repository analysis from 60 to 5,000 req/hr.
GITHUB_TOKEN=
