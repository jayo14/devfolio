# ==============================================================================
# Devfolio - Root Environment Configuration Example
# ==============================================================================
# For backend configuration, see server/.env.example
# Copy server/.env.example to server/.env:
#   cp server/.env.example server/.env

# Google Gemini API Key (Backend only - never expose to frontend)
GEMINI_API_KEY=AIzaSyDummyKey_ReplaceWithYourActualGeminiApiKey

# Database URL
DATABASE_URL=sqlite:///./devfolio.db

# JWT Secret
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-in-production

# Vite Frontend Backend Proxy (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
